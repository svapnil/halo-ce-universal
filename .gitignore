# IDE folders
.idea/
.vs/

# Caches
__pycache__
.mypy_cache
.cache/

# Build files
build/
.ninja_*
build.ninja

# Generated configs
compile_commands.json

# The January build and the Xbox SDK (tools/xdk_headers.py reads the
# build's PDB); never commit
*.exe
*.pdb
xbox/
!source/**/xbox/

# Locally extracted proprietary game data (never commit)
assets/
# (but the high-res assets, drawn for the port: tools/hud_assets.py)
!port/assets/
original/

# CI build outputs (tools/ci_build.py)
dist/

# The browser build's server (port/web: package.json, wrangler.toml), its
# local state (with a copy of the maps) and its local secrets
node_modules/
.wrangler/
.dev.vars*
